---
import { isSvg } from "../lib/image";
import { localize, t, type Locale } from "../lib/i18n";
import { localizedHref, siteLink } from "../lib/links";
import type { HomeItem } from "../lib/queries";
import type { HOME_QUERY_RESULT } from "../lib/sanity.types";
import Figure from "./Figure.astro";
import Modal from "./Modal.astro";
import RichText from "./RichText.astro";
import SvgSlot from "./SvgSlot.astro";
import InlineScript from "./InlineScript.astro";
import shuffle from "../inline/shuffle.js?raw";

interface Props {
  data: NonNullable<HOME_QUERY_RESULT>;
  locale: Locale;
}
const { data, locale } = Astro.props;
const items = (data.items ?? []).filter((i): i is HomeItem => Boolean(i.image?.url));
const date = (d: string) => new Date(d).toLocaleDateString("fr-FR");
---

<div class="content--home">
  {
    data.news?.map((news) => (
      <Modal id={`news-${news._key}`} label={localize(locale, news.title) ?? ""} closeLabel={t(locale, "close")} big autoOpen={500}>
        <div class="news-item text-display-lg">
          <div class="title">{localize(locale, news.title)}</div>
          {news.date && <div class="date">{date(news.date)}</div>}
          <div class="text">
            <RichText value={localize(locale, news.text)} />
          </div>
          {news.link?.link && (
            <a href={news.link.link} target="_blank" rel="noopener noreferrer">
              {news.link.label}
            </a>
          )}
        </div>
      </Modal>
    ))
  }

  <div class="grid grid-cols-2 md:grid-cols-5 gap-xs md:gap-gutter" data-home-grid>
    {
      items.map((item, i) => {
        const { image, project } = item;
        const title = localize(locale, project?.title) ?? "";
        const href = project ? localizedHref(locale, { _type: "project", slug: project.slug }) : siteLink(locale, item.link);
        const svg = isSvg(image);
        return (
          <article
            class:list={["card card--home", project && "has-verso", href && "has-link"]}
            data-kind={svg ? "svg" : "img"}
            style="--flip-deg:180deg">
            <a href={href || undefined} title={title || undefined}>
              <div class="perspective">
                <div class="card--home__inner">
                  <div class="recto">
                    {svg ? (
                      <SvgSlot image={image} alt={title} />
                    ) : (
                      <Figure image={image} alt={title} width={800} sizes="(max-width: 768px) 50vw, 20vw" priority={i < 5} />
                    )}
                  </div>
                  {project && (
                    <div class="verso" aria-hidden="true">
                      <div class="header">
                        <div class="ty">{localize(locale, project.type)}</div>
                        <div class="year text-right">{localize(locale, project.year)}</div>
                      </div>
                      <div class="body">
                        <h2>{title}</h2>
                      </div>
                      <div class="footer">
                        <div class="city">{project.city}</div>
                        <div class="client text-right">{project.client}</div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </a>
          </article>
        );
      })
    }
  </div>
  <InlineScript code={shuffle} />

  <div class="credits">
    <p>
      Production <a href="https://www.aha-paris.com" rel="noreferrer noopener" target="_blank">AHA</a><br />
      Design <a href="http://jbparre.com/" rel="noreferrer noopener" target="_blank">Jean-Baptiste Parré</a><br />
      Code <a href="https://github.com/ThomasOliverKimble/atelier-rita" rel="noreferrer noopener" target="_blank">Thomas Kimble</a><br />
      Illustration carte Rita <a href="https://www.instagram.com/zoe.bourhis/" rel="noreferrer noopener" target="_blank">Zoé Bourhis</a>
    </p>
  </div>
</div>

<script>
  import "../scripts/modal";
  import "../scripts/svg";
  import "../scripts/home";
</script>
